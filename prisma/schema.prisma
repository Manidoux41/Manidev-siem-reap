generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  IN_DEVELOPMENT
  TEST
  PRODUCTION
  UNKNOWN
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  businessCards BusinessCard[]
}

model BusinessCard {
  id        String    @id @default(cuid())
  label     String
  data      Json
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  shortDescription  String              @db.VarChar(240)
  description       String              @db.Text
  problem           String?             @db.Text
  solution          String?             @db.Text
  status            ProjectStatus       @default(UNKNOWN)
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImage        String?
  githubUrl         String?
  liveUrl           String?
  appUrl            String?
  featured          Boolean             @default(false)
  published         Boolean             @default(false)
  sortOrder         Int                 @default(0)
  publishedAt       DateTime?
  repoFullName      String?             @unique
  githubDescription String?             @db.Text
  githubLanguage    String?
  githubStars       Int?
  githubUpdatedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  technologies      ProjectTechnology[]
  images            ProjectImage[]
  skills            ProjectSkill[]
  testimonials      Testimonial[]

  @@index([published, featured, sortOrder])
  @@index([categoryId])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  displayName        String            @db.VarChar(100)
  testimony          String            @db.VarChar(2000)
  publicationConsent Boolean
  consentedAt        DateTime
  status             TestimonialStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([projectId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  sortOrder   Int       @default(0)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Technology {
  id        String              @id @default(cuid())
  name      String
  slug      String              @unique
  category  String
  icon      String?
  projects  ProjectTechnology[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

model Experience {
  id           String    @id @default(cuid())
  title        String
  organization String?
  description  String    @db.Text
  startDate    DateTime?
  endDate      DateTime?
  sortOrder    Int       @default(0)
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Skill {
  id          String         @id @default(cuid())
  name        String
  category    String
  description String?        @db.Text
  sortOrder   Int            @default(0)
  published   Boolean        @default(false)
  projects    ProjectSkill[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([name, category])
  @@index([published, category, sortOrder])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  notificationPending Boolean @default(false)
  notificationClaimedAt DateTime?
  notifiedAt DateTime?

  @@index([status, createdAt])
  @@index([notificationPending, notificationClaimedAt])
}

model RateLimitEntry {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
